---
layout: null
permalink: /search.json
---
[{% assign _ts = site.time | date: "%s" %}{% for s in site.studies %}{% assign _ds = s.date | date: "%s" %}{"t":{{ s.title | jsonify }},"p":{{ s.passage | default: "" | jsonify }},"u":{{ s.url | relative_url | jsonify }},"y":{{ s.type | jsonify }},"s":{{ s.summary | jsonify }},"b":{{ s.books | jsonify }},"r":{{ s.references | jsonify }},"k":{{ s.topics | jsonify }},"d":{% if _ds != _ts %}{{ s.date | date: "%b %Y" | jsonify }}{% else %}""{% endif %},"c":{{ s.content | strip_html | normalize_whitespace | truncatewords: 400, "" | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
