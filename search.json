[{% for s in site.studies %}{"t":{{ s.title | jsonify }},"u":{{ s.url | relative_url | jsonify }},"y":{{ s.type | jsonify }},"s":{{ s.summary | jsonify }},"b":{{ s.books | jsonify }},"r":{{ s.references | jsonify }},"k":{{ s.topics | jsonify }},"d":{{ s.date | date: "%b %Y" | jsonify }},"c":{{ s.content | strip_html | normalize_whitespace | truncatewords: 400, "" | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
